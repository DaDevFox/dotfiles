[submodule "tmux/.config/tmux/plugins/tmux-sensible"]
	path = tmux/plugins/tmux-sensible
	url = https://github.com/tmux-plugins/tmux-sensible
[submodule "tmux/.config/tmux/plugins/tpm"]
	path = tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm
[submodule "tmux/.config/tmux/plugins/tmux"]
	path = tmux/plugins/tmux/tmux
	url = https://git::@github.com/catppuccin/tmux
[submodule "tmux/tmux/.tmux/plugins/tpm"]
	path = tmux/tmux/.tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm
